/* LiberArk68 - RIGHT half (peripheral). Mirrored PCB, same wiring as left. */

#include "liberark68.dtsi"
#include "liberark68_kscan.dtsi"

/*
 * Shift this side's local kscan rows (0..2) into the combined matrix
 * rows (3..5) so the right half's keys index the right slice of
 * default_transform's map.
 */
&default_transform {
    row-offset = <3>;
};

/* Enable this half's two encoders (global sensor indices 2 and 3). */
&right_encoder_top {
    status = "okay";
};

&right_encoder_bottom {
    status = "okay";
};
