/*
 * LiberArk68 - shared devicetree fragments (matrix transform + physical layout).
 *
 * Logical combined matrix is 6x12: rows 0..2 are the LEFT half, rows 3..5 are
 * the RIGHT half. Each side scans its own local 3x12 matrix; the right side's
 * overlay applies row-offset=3 so its keys land in the right slice.
 *
 * Bindings/key order (72 total): L row 0 cols 0..11, R row 0 cols 0..11,
 * L row 1 cols 0..11, R row 1 cols 0..11, L row 2 cols 0..9, R row 2 cols 0..9,
 * then the four encoder push-switches appended last (positions 68..71):
 * L (2,10), L (2,11), R (5,10), R (5,11).
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include "liberark68_encoders.dtsi"

/ {
    chosen {
        /* zmk,matrix-transform is sourced from the physical-layout's */
        /* `transform` property; ZMK Studio's build assertion rejects it here. */
        zmk,physical-layout = &default_physical_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)   RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)   RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)                     RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7) RC(5,8) RC(5,9)
RC(2,10) RC(2,11)   RC(5,10) RC(5,11)
        >;
    };

    /*
     * Physical layout for ZMK Studio rendering. Positions are converted from
     * the LiberArk68 KLE (column-staggered with rotated thumb cluster).
     * Values: w/h/x/y in 1/100 keyunit (1u = 100), rotation in 1/100 degree.
     * Entry order matches the matrix-transform map above.
     */
    default_physical_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "LiberArk68";
        transform = <&default_transform>;
        keys
            /* row 0 L */
            = <&key_physical_attrs  100  100     0    70      0    0    0>  /* (0,0) ESC */
            , <&key_physical_attrs  100  100   100    50      0    0    0>  /* (1,0) 1 */
            , <&key_physical_attrs  100  100   200    15      0    0    0>  /* (2,0) 2 */
            , <&key_physical_attrs  100  100   300     0      0    0    0>  /* (3,0) 3 */
            , <&key_physical_attrs  100  100   400    18      0    0    0>  /* (4,0) 4 */
            , <&key_physical_attrs  100  100   500    35      0    0    0>  /* (5,0) 5 */
            , <&key_physical_attrs  100  100     0   170      0    0    0>  /* (6,0) Tab */
            , <&key_physical_attrs  100  100   100   150      0    0    0>  /* (7,0) Q */
            , <&key_physical_attrs  100  100   200   115      0    0    0>  /* (8,0) W */
            , <&key_physical_attrs  100  100   300   100      0    0    0>  /* (9,0) E */
            , <&key_physical_attrs  100  100   400   118      0    0    0>  /* (10,0) R */
            , <&key_physical_attrs  100  100   500   135      0    0    0>  /* (11,0) T */
            /* row 0 R */
            , <&key_physical_attrs  100  100  1525    70      0    0    0>  /* (0,0) Bksp */
            , <&key_physical_attrs  100  100  1425    50      0    0    0>  /* (1,0) 0 */
            , <&key_physical_attrs  100  100  1325    15      0    0    0>  /* (2,0) 9 */
            , <&key_physical_attrs  100  100  1225     0      0    0    0>  /* (3,0) 8 */
            , <&key_physical_attrs  100  100  1125    18      0    0    0>  /* (4,0) 7 */
            , <&key_physical_attrs  100  100  1025    35      0    0    0>  /* (5,0) 6 */
            , <&key_physical_attrs  100  100  1525   170      0    0    0>  /* (6,0) \ */
            , <&key_physical_attrs  100  100  1425   150      0    0    0>  /* (7,0) P */
            , <&key_physical_attrs  100  100  1325   115      0    0    0>  /* (8,0) O */
            , <&key_physical_attrs  100  100  1225   100      0    0    0>  /* (9,0) I */
            , <&key_physical_attrs  100  100  1125   118      0    0    0>  /* (10,0) U */
            , <&key_physical_attrs  100  100  1025   135      0    0    0>  /* (11,0) Y */
            /* row 1 L */
            , <&key_physical_attrs  100  100     0   270      0    0    0>  /* (0,1) Layer 4 */
            , <&key_physical_attrs  100  100   100   250      0    0    0>  /* (1,1) A */
            , <&key_physical_attrs  100  100   200   215      0    0    0>  /* (2,1) S */
            , <&key_physical_attrs  100  100   300   200      0    0    0>  /* (3,1) D */
            , <&key_physical_attrs  100  100   400   217      0    0    0>  /* (4,1) F */
            , <&key_physical_attrs  100  100   500   235      0    0    0>  /* (5,1) G */
            , <&key_physical_attrs  100  100     0   370      0    0    0>  /* (6,1) Shift */
            , <&key_physical_attrs  100  100   100   350      0    0    0>  /* (7,1) Z */
            , <&key_physical_attrs  100  100   200   315      0    0    0>  /* (8,1) X */
            , <&key_physical_attrs  100  100   300   300      0    0    0>  /* (9,1) C */
            , <&key_physical_attrs  100  100   400   318      0    0    0>  /* (10,1) V */
            , <&key_physical_attrs  100  100   500   335      0    0    0>  /* (11,1) B */
            /* row 1 R */
            , <&key_physical_attrs  100  100  1525   270      0    0    0>  /* (0,1) ' */
            , <&key_physical_attrs  100  100  1425   250      0    0    0>  /* (1,1) ; */
            , <&key_physical_attrs  100  100  1325   215      0    0    0>  /* (2,1) L */
            , <&key_physical_attrs  100  100  1225   200      0    0    0>  /* (3,1) K */
            , <&key_physical_attrs  100  100  1125   217      0    0    0>  /* (4,1) J */
            , <&key_physical_attrs  100  100  1025   235      0    0    0>  /* (5,1) H */
            , <&key_physical_attrs  100  100  1525   370      0    0    0>  /* (6,1) Enter */
            , <&key_physical_attrs  100  100  1425   350      0    0    0>  /* (7,1) ? */
            , <&key_physical_attrs  100  100  1325   315      0    0    0>  /* (8,1) . */
            , <&key_physical_attrs  100  100  1225   300      0    0    0>  /* (9,1) , */
            , <&key_physical_attrs  100  100  1125   318      0    0    0>  /* (10,1) M */
            , <&key_physical_attrs  100  100  1025   335      0    0    0>  /* (11,1) N */
            /* row 2 L */
            , <&key_physical_attrs  100  100     0   470      0    0    0>  /* (0,2) Ctrl */
            , <&key_physical_attrs  100  100   100   450      0    0    0>  /* (1,2) Alt */
            , <&key_physical_attrs  100  100   200   428      0    0    0>  /* (2,2) Hyper */
            , <&key_physical_attrs  100  100   300   415      0    0    0>  /* (3,2) F12 */
            , <&key_physical_attrs  100  100   430   420   1500  430  420>  /* (4,2) Layer 2 */
            , <&key_physical_attrs  150  100   555   445   2500  525  420>  /* (5,2) Space */
            , <&key_physical_attrs  100  100   745   575   4000  780  495>  /* (6,2) Enter */
            , <&key_physical_attrs  100  100   600   345      0    0    0>  /* (7,2) ` */
            , <&key_physical_attrs  100  100   600   245      0    0    0>  /* (8,2) [ */
            , <&key_physical_attrs  100  100   600   145      0    0    0>  /* (9,2) - */
            /* row 2 R */
            , <&key_physical_attrs  100  100  1525   470      0    0    0>  /* (0,2) Right */
            , <&key_physical_attrs  100  100  1425   450      0    0    0>  /* (1,2) Down */
            , <&key_physical_attrs  100  100  1325   428      0    0    0>  /* (2,2) Up */
            , <&key_physical_attrs  100  100  1225   415      0    0    0>  /* (3,2) Left */
            , <&key_physical_attrs  100  100  1099   445 (-1500) 1099  445>  /* (4,2) Layer 3 */
            , <&key_physical_attrs  150  100   940   525 (-2500)  918  510>  /* (5,2) Space */
            , <&key_physical_attrs  100  100   825   620 (-4000)  800  580>  /* (6,2) Enter */
            , <&key_physical_attrs  100  100   925   345      0    0    0>  /* (7,2) F11 */
            , <&key_physical_attrs  100  100   925   245      0    0    0>  /* (8,2) ] */
            , <&key_physical_attrs  100  100   925   145      0    0    0>  /* (9,2) = */
            /* encoder push-switches: L top, L bottom, R top, R bottom */
            , <&key_physical_attrs  100  100   700   195      0    0    0>  /* (2,10) L enc-top  Play/Pause */
            , <&key_physical_attrs  100  100   700   295      0    0    0>  /* (2,11) L enc-bot  Mute */
            , <&key_physical_attrs  100  100   825   195      0    0    0>  /* (5,10) R enc-top  Next */
            , <&key_physical_attrs  100  100   825   295      0    0    0>  /* (5,11) R enc-bot  Prev */
            ;
    };
};
