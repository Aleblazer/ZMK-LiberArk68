/*
 * LiberArk68 default keymap.
 *
 * Bindings order matches the matrix-transform map in liberark68.dtsi:
 *   row 0: L cols 0..11, then R cols 0..11   (24)
 *   row 1: L cols 0..11, then R cols 0..11   (24)
 *   row 2: L cols 0..9,  then R cols 0..9    (20)
 *   left encoder pushes: top, bottom         (2)
 *
 * Momentary layer keys from the KLE: L outer-mid -> mo 4, L thumb -> mo 2,
 * R thumb -> mo 3. Layers 1-4 are placeholder &trans; fill them in via Studio
 * or by editing the layer_N blocks below.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define TRANS_ROW_24 \
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans \
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

#define TRANS_ROW_20 \
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans \
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

/* two encoder push-switch positions (L top, L bottom) */
#define TRANS_ENC &trans &trans

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
/* row 0  L0..L11                                                                                       R0..R11                                                                                  */
&kp ESC   &kp N1  &kp N2    &kp N3   &kp N4    &kp N5    &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T   &kp BSPC   &kp N0  &kp N9    &kp N8   &kp N7  &kp N6   &kp BSLH   &kp P  &kp O  &kp I  &kp U  &kp Y

/* row 1                                                                                                                                                                                          */
&mo 4    &kp A   &kp S     &kp D    &kp F     &kp G    &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B    &kp SQT    &kp SEMI &kp L  &kp K  &kp J  &kp H  &kp RET    &kp QMARK &kp DOT &kp COMMA &kp M &kp N

/* row 2  L0..L9                                                                              R0..R9                                                                                              */
&kp LCTRL &kp LALT &kp LGUI &kp F12  &mo 2     &kp SPACE &kp RET    &kp GRAVE &kp LBKT &kp MINUS    &kp RIGHT &kp DOWN &kp UP &kp LEFT &mo 3 &kp SPACE &kp RET   &kp F11  &kp RBKT  &kp EQUAL

/* encoder push:  L-top      L-bottom */
&kp C_PP   &kp C_MUTE
            >;

            /*
             * Top encoder sends F23/F24 — silent in normal apps by design;
             * bind them in macro/hotkey software. Verified working on
             * hardware via a temporary PG_UP/PG_DN swap.
             */
            sensor-bindings
                = <&inc_dec_kp F23 F24>             /* 0  left top    */
                , <&inc_dec_kp C_VOL_UP C_VOL_DN>;  /* 1  left bottom */
        };

        layer_1 {
            display-name = "L1";
            bindings = <
                TRANS_ROW_24
                TRANS_ROW_24
                TRANS_ROW_20
                TRANS_ENC
            >;
        };

        layer_2 {
            display-name = "L2";
            bindings = <
                TRANS_ROW_24
                TRANS_ROW_24
                TRANS_ROW_20
                TRANS_ENC
            >;
        };

        layer_3 {
            display-name = "L3";
            bindings = <
                TRANS_ROW_24
                TRANS_ROW_24
                TRANS_ROW_20
                TRANS_ENC
            >;
        };

        layer_4 {
            display-name = "L4";
            bindings = <
                TRANS_ROW_24
                TRANS_ROW_24
                TRANS_ROW_20
                TRANS_ENC
            >;
        };
    };
};
