/*
 * LiberArk68 - shared devicetree fragments
 *
 * Logical combined matrix:
 *   rows 0..2 = LEFT side (physical rows 0..2)
 *   rows 3..5 = RIGHT side (physical rows 0..2 mapped to 3..5)
 *   cols 0..11 = COL0..COL11 on the local 595 daisy-chain
 *
 * Each side scans its OWN local 3x12 matrix; the split layer combines
 * them into the 6x12 logical matrix used by the matrix-transform below.
 *
 * Bindings array order (used by liberark68.keymap):
 *   row 0: L cols 0..11, then R cols 0..11      (24 keys)
 *   row 1: L cols 0..11, then R cols 0..11      (24 keys)
 *   row 2: L cols 0..9,  then R cols 0..9       (20 keys, no col 10/11 in row 2)
 *   total = 68
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,matrix-transform = &default_transform;
        zmk,physical-layout = &default_physical_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)   RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)   RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)                     RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7) RC(5,8) RC(5,9)
        >;
    };

    /*
     * Physical layout for ZMK Studio rendering.
     * NOTE: This is a placeholder flat 3x24 ortho grid (positions in 1/100 keyunit;
     * keys are 100x100, 200-unit gap between halves). It is NOT visually accurate
     * vs. the actual column-staggered LiberArk68 KLE — refine positions later by
     * converting the KLE to absolute (x,y,r,rx,ry) values. The KEY ORDER must keep
     * matching the matrix-transform map above.
     */
    default_physical_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "LiberArk68";
        transform = <&default_transform>;
        keys
            //                         w    h     x     y    rot   rx   ry
            /* row 0 — left (12) */
            = <&key_physical_attrs   100  100     0     0      0    0    0>
            , <&key_physical_attrs   100  100   100     0      0    0    0>
            , <&key_physical_attrs   100  100   200     0      0    0    0>
            , <&key_physical_attrs   100  100   300     0      0    0    0>
            , <&key_physical_attrs   100  100   400     0      0    0    0>
            , <&key_physical_attrs   100  100   500     0      0    0    0>
            , <&key_physical_attrs   100  100   600     0      0    0    0>
            , <&key_physical_attrs   100  100   700     0      0    0    0>
            , <&key_physical_attrs   100  100   800     0      0    0    0>
            , <&key_physical_attrs   100  100   900     0      0    0    0>
            , <&key_physical_attrs   100  100  1000     0      0    0    0>
            , <&key_physical_attrs   100  100  1100     0      0    0    0>
            /* row 0 — right (12) */
            , <&key_physical_attrs   100  100  1300     0      0    0    0>
            , <&key_physical_attrs   100  100  1400     0      0    0    0>
            , <&key_physical_attrs   100  100  1500     0      0    0    0>
            , <&key_physical_attrs   100  100  1600     0      0    0    0>
            , <&key_physical_attrs   100  100  1700     0      0    0    0>
            , <&key_physical_attrs   100  100  1800     0      0    0    0>
            , <&key_physical_attrs   100  100  1900     0      0    0    0>
            , <&key_physical_attrs   100  100  2000     0      0    0    0>
            , <&key_physical_attrs   100  100  2100     0      0    0    0>
            , <&key_physical_attrs   100  100  2200     0      0    0    0>
            , <&key_physical_attrs   100  100  2300     0      0    0    0>
            , <&key_physical_attrs   100  100  2400     0      0    0    0>
            /* row 1 — left (12) */
            , <&key_physical_attrs   100  100     0   100      0    0    0>
            , <&key_physical_attrs   100  100   100   100      0    0    0>
            , <&key_physical_attrs   100  100   200   100      0    0    0>
            , <&key_physical_attrs   100  100   300   100      0    0    0>
            , <&key_physical_attrs   100  100   400   100      0    0    0>
            , <&key_physical_attrs   100  100   500   100      0    0    0>
            , <&key_physical_attrs   100  100   600   100      0    0    0>
            , <&key_physical_attrs   100  100   700   100      0    0    0>
            , <&key_physical_attrs   100  100   800   100      0    0    0>
            , <&key_physical_attrs   100  100   900   100      0    0    0>
            , <&key_physical_attrs   100  100  1000   100      0    0    0>
            , <&key_physical_attrs   100  100  1100   100      0    0    0>
            /* row 1 — right (12) */
            , <&key_physical_attrs   100  100  1300   100      0    0    0>
            , <&key_physical_attrs   100  100  1400   100      0    0    0>
            , <&key_physical_attrs   100  100  1500   100      0    0    0>
            , <&key_physical_attrs   100  100  1600   100      0    0    0>
            , <&key_physical_attrs   100  100  1700   100      0    0    0>
            , <&key_physical_attrs   100  100  1800   100      0    0    0>
            , <&key_physical_attrs   100  100  1900   100      0    0    0>
            , <&key_physical_attrs   100  100  2000   100      0    0    0>
            , <&key_physical_attrs   100  100  2100   100      0    0    0>
            , <&key_physical_attrs   100  100  2200   100      0    0    0>
            , <&key_physical_attrs   100  100  2300   100      0    0    0>
            , <&key_physical_attrs   100  100  2400   100      0    0    0>
            /* row 2 — left (10) */
            , <&key_physical_attrs   100  100     0   200      0    0    0>
            , <&key_physical_attrs   100  100   100   200      0    0    0>
            , <&key_physical_attrs   100  100   200   200      0    0    0>
            , <&key_physical_attrs   100  100   300   200      0    0    0>
            , <&key_physical_attrs   100  100   400   200      0    0    0>
            , <&key_physical_attrs   100  100   500   200      0    0    0>
            , <&key_physical_attrs   100  100   600   200      0    0    0>
            , <&key_physical_attrs   100  100   700   200      0    0    0>
            , <&key_physical_attrs   100  100   800   200      0    0    0>
            , <&key_physical_attrs   100  100   900   200      0    0    0>
            /* row 2 — right (10) */
            , <&key_physical_attrs   100  100  1300   200      0    0    0>
            , <&key_physical_attrs   100  100  1400   200      0    0    0>
            , <&key_physical_attrs   100  100  1500   200      0    0    0>
            , <&key_physical_attrs   100  100  1600   200      0    0    0>
            , <&key_physical_attrs   100  100  1700   200      0    0    0>
            , <&key_physical_attrs   100  100  1800   200      0    0    0>
            , <&key_physical_attrs   100  100  1900   200      0    0    0>
            , <&key_physical_attrs   100  100  2000   200      0    0    0>
            , <&key_physical_attrs   100  100  2100   200      0    0    0>
            , <&key_physical_attrs   100  100  2200   200      0    0    0>
            ;
    };
};
