/* LiberArk68 - LEFT half (peripheral). */

#include "liberark68.dtsi"
#include "liberark68_kscan.dtsi"

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/* Enable this half's two encoders (global sensor indices 0 and 1). */
&left_encoder_top {
    status = "okay";
};

&left_encoder_bottom {
    status = "okay";
};

/*
 * PHASE 0 (bring-up): prove the 10k fader reads on P0.04 = AIN2 = VIK-SDA.
 * Pot: one end 3V3, other GND, wiper -> P0.04. The badjeff analog-input
 * driver samples it; with CONFIG_ANALOG_INPUT_LOG_DBG_RAW=y the raw value
 * prints over the USB console so we can confirm motion before building any
 * of the split/HID/PC pipeline. evt-type/scale here are placeholders — the
 * absolute 0..100 mapping is a later phase.
 */
&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN2>;   /* P0.04 */
        zephyr,resolution = <12>;
        zephyr,oversampling = <0>;                  /* nRF52840 SAADC: must be 0 */
    };
};

/ {
    fader_left: analog_input_0 {
        compatible = "zmk,analog-input";
        sampling-hz = <50>;
        x-ch {
            io-channels = <&adc 2>;
            mv-mid = <1650>;
            mv-min-max = <1650>;
            mv-deadzone = <0>;
            scale-multiplier = <1>;
            scale-divisor = <33>;
            evt-type = <INPUT_EV_ABS>;
            input-code = <INPUT_ABS_X>;
            report-on-change-only;
        };
    };
};
