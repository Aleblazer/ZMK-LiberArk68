/*
 * LiberArk68 - 10k slide fader (shared by both halves).
 *
 * VIK-GP1 (P1.11) can't be sampled — no P1 pin reaches the nRF52840 SAADC —
 * so each half's fader wiper goes to VIK-SDA = P0.04 = AIN2 instead
 * (one outer leg to 3V3, the other to GND).
 *
 * Reports the absolute wiper voltage in mV (0..~3300) over hid-io's 16-bit
 * joystick axis:
 *   mv-mid = 0     -> report absolute position, not a centered joystick offset
 *   scale 1/1      -> pass the raw mV straight through (no 8-bit crush)
 *   report-on-change-only fires on any change.
 *
 * The pot is sold as B103 (linear) 10k but reads strongly compressed at the top
 * of travel (measured travel->mV: 0/25/50/75/100% -> ~7/148/1831/3560/3732), so
 * the top third collapses into ~150 ADC counts. We do NOT linearize here -- the
 * firmware sends the full-resolution mV and the PC app applies a piecewise-linear
 * calibration curve. Sending 16-bit (vs the old 8-bit 0..254, which crushed that
 * top to ~10 codes) preserves the resolution the compressed top still has.
 * Longer ADC acquisition time settles the 10k source and trims sample noise.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * Each half tags its fader with a distinct axis so the dongle's HID-IO
 * joystick can carry both: left = INPUT_ABS_X, right = INPUT_ABS_Y. The
 * including overlay sets FADER_INPUT_CODE before including this file.
 */
#ifndef FADER_INPUT_CODE
#define FADER_INPUT_CODE INPUT_ABS_X
#endif

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive = <NRF_SAADC_AIN2>;   /* P0.04 = VIK-SDA */
        zephyr,resolution = <12>;
        zephyr,oversampling = <0>;                  /* nRF52840 SAADC: must be 0 */
    };
};

/ {
    fader: analog_input_0 {
        compatible = "zmk,analog-input";
        /* 30 Hz is plenty for a volume fader; lower than the old 50 to cut the
         * peripherals' BLE report rate (battery) with no perceptible lag. */
        sampling-hz = <30>;
        x-ch {
            io-channels = <&adc 2>;
            mv-mid = <0>;
            mv-min-max = <3300>;
            mv-deadzone = <0>;
            scale-multiplier = <1>;
            scale-divisor = <1>;
            evt-type = <INPUT_EV_ABS>;
            input-code = <FADER_INPUT_CODE>;
            report-on-change-only;
            /* Settle mode: report every change while moving (full 16-bit
             * resolution, including the compressed ends), then go quiet once the
             * wiper has stayed within report-threshold mV of its anchor for
             * report-settle-samples in a row, so the peripheral can deep-sleep.
             * report-threshold is just the rest/wake band (~ the noise floor), not
             * a movement quantizer. At 30 Hz, 300 samples ~= 10 s of stillness,
             * which keeps full resolution through a fine-tuning session before it
             * goes quiet. Raise report-threshold if resting noise still keeps it
             * awake; lower it (toward the noise floor) once the grounding/0.1uF
             * fix is in. */
            report-threshold = <30>;
            report-settle-samples = <300>;
        };
    };
};
