/*
 * LiberArk68 default keymap
 *
 * Bindings array order (matches matrix-transform map in liberark68.dtsi):
 *   row 0: L cols 0..11, then R cols 0..11   (24)
 *   row 1: L cols 0..11, then R cols 0..11   (24)
 *   row 2: L cols 0..9,  then R cols 0..9    (20)
 *
 * Layer references from KLE:
 *   "Layer 4" -> &mo 4 (left outer mid)
 *   "Layer 2" -> &mo 2 (left thumb)
 *   "Layer 3" -> &mo 3 (right thumb)
 *
 * "Hyper" position = LGUI (per user)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define TRANS_ROW_24 \
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans \
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

#define TRANS_ROW_20 \
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans \
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
/* row 0  L0..L11                                                                                       R0..R11                                                                                  */
&kp ESC   &kp N1  &kp N2    &kp N3   &kp N4    &kp N5    &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T   &kp BSPC   &kp N0  &kp N9    &kp N8   &kp N7  &kp N6   &kp BSLH   &kp P  &kp O  &kp I  &kp U  &kp Y

/* row 1                                                                                                                                                                                          */
&mo 4    &kp A   &kp S     &kp D    &kp F     &kp G    &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B    &kp SQT    &kp SEMI &kp L  &kp K  &kp J  &kp H  &kp RET    &kp QMARK &kp DOT &kp COMMA &kp M &kp N

/* row 2  L0..L9                                                                              R0..R9                                                                                              */
&kp LCTRL &kp LALT &kp LGUI &kp F12  &mo 2     &kp SPACE &kp RET    &kp GRAVE &kp LBKT &kp MINUS    &kp RIGHT &kp DOWN &kp UP &kp LEFT &mo 3 &kp SPACE &kp RET   &kp F11  &kp RBKT  &kp EQUAL
            >;
        };

        layer_1 {
            display-name = "L1";
            bindings = <
                TRANS_ROW_24
                TRANS_ROW_24
                TRANS_ROW_20
            >;
        };

        layer_2 {
            display-name = "L2";
            bindings = <
                TRANS_ROW_24
                TRANS_ROW_24
                TRANS_ROW_20
            >;
        };

        layer_3 {
            display-name = "L3";
            bindings = <
                TRANS_ROW_24
                TRANS_ROW_24
                TRANS_ROW_20
            >;
        };

        layer_4 {
            display-name = "L4";
            bindings = <
                TRANS_ROW_24
                TRANS_ROW_24
                TRANS_ROW_20
            >;
        };
    };
};
