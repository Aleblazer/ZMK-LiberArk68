/*
 * LiberArk68 - DONGLE (Xiao nRF52840 + Prospector adapter, ILI9341 320x240).
 * Pure BLE central — no local kscan. Hosts the keymap, matrix transform,
 * and physical layout so ZMK Studio can edit them. The display is wired up
 * by the prospector_adapter shield.
 *
 * Faders: receives each half's fader over the split link (reg 0 = left,
 * reg 1 = right) and forwards them out the zmk-hid-io joystick interface
 * (left -> axis X, right -> axis Y) for the PC volume app to read.
 */

#include "liberark68.dtsi"

/*
 * FT6336 capacitive touch controller on the display module.
 *
 * Wiring:
 *   TP_SDA -> Xiao D4 / P0.04
 *   TP_SCL -> Xiao D5 / P0.05
 *   TP_INT -> Xiao D0 / P0.02
 *   TP_RST -> Xiao D1 / P0.03
 *
 * The LiberArk touchpad driver reads both FT6336 contacts and emits relative
 * pointer, mouse-button, and scroll events directly into ZMK.
 */
&i2c1 {
    status = "okay";

    touch_sensor: ft6336@38 {
        compatible = "liberark,ft6336-touchpad";
        reg = <0x38>;
        status = "okay";
        int-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        reset-gpios = <&xiao_d 1 GPIO_ACTIVE_LOW>;
        invert-x;
        pointer-multiplier = <5>;
        pointer-divisor = <2>;
        scroll-divisor = <12>;
        tap-time-ms = <220>;
        tap-move-threshold = <12>;
        scroll-start-threshold = <6>;
        click-release-ms = <12>;
    };
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        fader_split_left: fader_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };

        fader_split_right: fader_split@1 {
            compatible = "zmk,input-split";
            reg = <1>;
        };
    };

    /* Forward INPUT_EV_ABS events out the HID-IO joystick (usage 2). */
    zip_fwd_to_hid_io: zip_fwd_to_hid_io {
        compatible = "zmk,input-processor-fwd-to-hid-io";
        #input-processor-cells = <0>;
        usage = <2>;   /* HID_IO_USAGE_FWD_TO_JOYSTICK */
    };

    fader_left_listener {
        compatible = "zmk,input-listener";
        device = <&fader_split_left>;
        input-processors = <&zip_fwd_to_hid_io>;
    };

    fader_right_listener {
        compatible = "zmk,input-listener";
        device = <&fader_split_right>;
        input-processors = <&zip_fwd_to_hid_io>;
    };

    touch_listener: touch_listener {
        compatible = "zmk,input-listener";
        device = <&touch_sensor>;
    };
};
