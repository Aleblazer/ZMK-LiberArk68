/*
 * LiberArk68 - 10k slide fader (shared by both halves).
 *
 * VIK-GP1 (P1.11) can't be sampled — no P1 pin reaches the nRF52840 SAADC —
 * so each half's fader wiper goes to VIK-SDA = P0.04 = AIN2 instead
 * (one outer leg to 3V3, the other to GND).
 *
 * Reports an absolute 0..255 value (high-res on purpose):
 *   mv-mid = 0     -> report absolute position, not a centered joystick offset
 *   scale 1/13     -> 3300 mV / 13 ~= 254
 *   report-on-change-only quantizes to whole steps to limit chatter.
 *
 * The pot is an S-taper, NOT linear (measured travel->raw: 0/25/50/75/100%
 * -> ~7/148/1831/3560/3732), so the middle of the throw covers ~90% of the
 * electrical range. We deliberately do NOT linearize here — the firmware
 * sends the raw-ish 0..255, and the PC app applies a piecewise-linear
 * calibration curve from those points. Keeping it high-res preserves what
 * little resolution the compressed ends have.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * Each half tags its fader with a distinct axis so the dongle's HID-IO
 * joystick can carry both: left = INPUT_ABS_X, right = INPUT_ABS_Y. The
 * including overlay sets FADER_INPUT_CODE before including this file.
 */
#ifndef FADER_INPUT_CODE
#define FADER_INPUT_CODE INPUT_ABS_X
#endif

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN2>;   /* P0.04 = VIK-SDA */
        zephyr,resolution = <12>;
        zephyr,oversampling = <0>;                  /* nRF52840 SAADC: must be 0 */
    };
};

/ {
    fader: analog_input_0 {
        compatible = "zmk,analog-input";
        sampling-hz = <50>;
        x-ch {
            io-channels = <&adc 2>;
            mv-mid = <0>;
            mv-min-max = <3300>;
            mv-deadzone = <0>;
            scale-multiplier = <1>;
            scale-divisor = <13>;
            evt-type = <INPUT_EV_ABS>;
            input-code = <FADER_INPUT_CODE>;
            report-on-change-only;
        };
    };
};
